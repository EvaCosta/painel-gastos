# ─── Planilha ──────────────────────────────────────────────────────────────
# Via A (recomendada): API do Sheets com conta de serviço. A folha fica privada;
# basta partilhá-la (leitura) com o email da conta de serviço.
PLANILHA_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Nome da aba a ler. Vazio = a primeira.
PLANILHA_ABA=

# Via B (mais simples, menos privada): Ficheiro → Partilhar → Publicar na web → CSV.
# Quem descobrir este link lê a planilha toda. Só é usada se a via A não estiver preenchida.
PLANILHA_CSV_URL=

# ─── Firebase ──────────────────────────────────────────────────────────────
# Definições do projeto → Contas de serviço → Gerar nova chave privada.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── App ───────────────────────────────────────────────────────────────────
# Segredo do cron. Gera com: openssl rand -hex 32
CRON_SECRET=
# Abre /admin/<este token> com a visão geral de todas as pessoas.
ADMIN_TOKEN=
# Usado para montar os links nos scripts e no painel de admin.
NEXT_PUBLIC_BASE_URL=https://painel-gastos.vercel.app
# Linha mostrada em "Como acertar" (ex.: uma chave Pix). Opcional.
INSTRUCOES_PAGAMENTO=
